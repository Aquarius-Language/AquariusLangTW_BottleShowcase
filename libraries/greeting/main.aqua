var numbers = import("BottleNumbers");
var files = import("Files");
var native = import("BottleGreetingNative");
var message, 訊息 = function() { return files.ReadAssetText("bottles/bottle_greeting/assets/message.txt", "utf-8"); };
var answer, 答案 = function() { return numbers.add(20, 22); };
var dynamicEcho, 動態回音 = function(text) { return native.Echo(text); };
